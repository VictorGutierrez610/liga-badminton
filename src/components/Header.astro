---
---

<header class="main-header glass-card">
  <div class="header-content">
    <div class="brand">
      <div class="brand-icon">🏸</div>
      <div>
        <h1 class="brand-title">Liga de Viernes UNI</h1>
        <p class="brand-sub">Bádminton Universitario · Partidos y competición</p>
      </div>
    </div>

    <div class="header-right">
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span id="connectionStatusText">Modo Local (Demostración)</span>
      </div>
      
      <div id="adminStatusBox" class="admin-status-box">
        <span id="adminStatusBadge" class="badge badge-borrador">👁️ Modo Espectador</span>
        <button id="btnOpenAdminModal" class="btn btn-primary btn-sm">
          🔐 Entrar Modo Admin
        </button>
        <button id="btnLogoutAdmin" class="btn btn-secondary btn-sm" style="display:none;">
          🚪 Salir Modo Admin
        </button>
      </div>
    </div>
  </div>

  <nav class="nav-tabs" id="appMainNavigation">
    <button class="nav-tab active" data-tab="matches">
      <span>🎾</span> Partidos
    </button>
    <button class="nav-tab" data-tab="manager">
      <span>⚙️</span> Gestor de Competición
    </button>
    <button class="nav-tab" data-tab="rankings">
      <span>🏆</span> Rankings de la Liga
    </button>
    <button class="nav-tab" data-tab="sheets">
      <span>📊</span> Conexión Google Sheets
    </button>
  </nav>
</header>

<!-- Modal: Autenticación Modo Administrador -->
<div id="adminPinModal" class="modal-overlay" style="display:none;">
  <div class="modal-content" style="max-width:420px;">
    <div class="modal-header">
      <h3 class="modal-title">🔐 Acceso a Modo Administrador</h3>
      <button class="modal-close" id="btnCloseAdminModal">✕</button>
    </div>

    <form id="adminPinForm">
      <p class="text-muted" style="font-size:13px; margin-bottom:14px;">
        Introduce el PIN de administración para editar jornadas, anotar resultados y sincronizar con la hoja de Google Sheets.
      </p>

      <div class="form-group">
        <label class="form-label" for="inputPinLogin">Código PIN de Administrador:</label>
        <input type="password" id="inputPinLogin" class="form-control" placeholder="Introduce tu PIN..." required autofocus />
      </div>

      <div id="adminPinError" class="text-red" style="font-size:13px; margin-bottom:12px; min-height:18px;"></div>

      <div class="flex-between">
        <button type="button" class="btn btn-secondary" id="btnCancelAdminModal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Validar & Entrar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .main-header {
    margin-bottom: 24px;
    padding: 20px 24px 12px 24px;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-icon {
    font-size: 36px;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px var(--primary-glow);
  }

  .brand-title {
    font-size: 24px;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.5px;
  }

  .brand-sub {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 0, 0, 0.3);
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--card-border);
    font-size: 12px;
    color: var(--primary-light);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .pin-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pin-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0;
  }

  .pin-input {
    width: 100px;
    padding: 6px 10px;
    font-size: 13px;
    background: rgba(10, 5, 20, 0.8);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    color: var(--text-main);
  }

  .nav-tabs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-top: 6px;
    border-top: 1px solid rgba(196, 181, 253, 0.1);
  }

  .nav-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid transparent;
    color: var(--text-muted);
    padding: 10px 18px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .nav-tab:hover {
    background: rgba(139, 92, 246, 0.12);
    color: var(--text-main);
  }

  .nav-tab.active {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 4px 15px var(--primary-glow);
  }
</style>
