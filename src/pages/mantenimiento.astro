---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mantenimiento · Liga de Bádminton UNI">
  <main class="maintenance-page">
    <section class="maintenance-card" aria-labelledby="maintenance-title">
      <div class="maintenance-icon" aria-hidden="true">🏸</div>
      <p class="maintenance-eyebrow">Liga de Viernes UNI</p>
      <h1 id="maintenance-title">Estamos mejorando la web</h1>
      <p class="maintenance-message">
        Estamos realizando tareas de mantenimiento para ofrecerte una mejor experiencia.
        La página volverá a estar disponible en cuanto terminemos.
      </p>
      <div class="maintenance-status">
        <span class="maintenance-status-dot" aria-hidden="true"></span>
        <span>Volvemos pronto</span>
      </div>
    </section>
  </main>
</Layout>

<style>
  .maintenance-page {
    display: grid;
    min-height: min(78vh, 760px);
    place-items: center;
    padding: 24px 0;
  }

  .maintenance-card {
    width: min(100%, 620px);
    padding: clamp(24px, 6vw, 48px);
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow), 0 18px 50px rgba(0, 0, 0, 0.3);
  }

  .maintenance-icon {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    margin: 0 auto 22px;
    border: 1px solid var(--card-border);
    border-radius: 22px;
    background: rgba(139, 92, 246, 0.14);
    font-size: 38px;
  }

  .maintenance-eyebrow {
    margin-bottom: 10px;
    color: var(--primary-light);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(28px, 6vw, 42px);
    line-height: 1.12;
  }

  .maintenance-message {
    max-width: 460px;
    margin: 18px auto 24px;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .maintenance-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 15px;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-main);
    font-size: 14px;
    font-weight: 600;
  }

  .maintenance-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 10px var(--accent-green);
  }
</style>
