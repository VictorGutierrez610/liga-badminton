---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Liga Bádminton Viernes UNI - Gestor & Visualizador' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content="Aplicación para visualizar partidos, llaves, clasificaciones y rankings de la Liga Universitaria de Bádminton de los Viernes." />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="app-background-effects">
			<div class="glow-orb glow-orb-1"></div>
			<div class="glow-orb glow-orb-2"></div>
		</div>

		<div class="app-container">
			<slot />
		</div>
	</body>
</html>
